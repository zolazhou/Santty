+/// Owned snapshots of the current PTY identity; a foreground group is not
+/// necessarily a live group-leader PID. No raw descriptor escapes the query.
+public struct LocalProcessTerminalInfo: Sendable {
+    public let shellPid: Int32
+    public let foregroundProcessGroupID: Int32?
+    public let ttyName: String
