+extension TerminalController {
+    /// Applies the resolved Ghostty policy without sending a host event through the VT parser.
+    func requestClipboardWrite(_ string: String, bridge: TerminalCallbackBridge) -> Bool {
+        guard string.utf8.count <= 2 * 1024 * 1024, bridge.rawSurface != nil, let config else { return false }
+        var policy: UnsafePointer<CChar>?
+        let key = "clipboard-write"
+        let found = key.withCString { ghostty_config_get(config, &policy, $0, UInt(key.utf8.count)) }
+        guard found, let policy else { return false }
+        let value = String(cString: policy)
+        if value == "deny" { return true }
+        guard value == "allow" || value == "ask" else { return false }
+        TerminalCallbacks.enqueueClipboardWrite(string, bridge: bridge, confirm: value == "ask",
+                                               generation: bridge.clipboardWriteGeneration)
+        return true
+    }
+}
