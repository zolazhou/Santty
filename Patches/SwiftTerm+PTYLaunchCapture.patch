+#if os(macOS)
+    private static func makeLaunchGate() -> (Int32, Int32)? {
+        var fds: [Int32] = [-1, -1]
+        guard pipe(&fds) == 0 else { return nil }
+        func failed() -> (Int32, Int32)? {
+            let failure = errno
+            fds.filter { $0 >= 0 }.forEach { close($0) }
+            errno = failure
+            return nil
+        }
+        for i in 0..<2 {
+            // login_tty replaces 0/1/2 in the child. Gate FDs must survive it.
+            if fds[i] < 3 {
+                let replacement = fcntl(fds[i], F_DUPFD_CLOEXEC, 3)
+                guard replacement >= 0 else { return failed() }
+                close(fds[i]); fds[i] = replacement
+            }
+            guard fcntl(fds[i], F_SETFD, FD_CLOEXEC) == 0 else { return failed() }
+        }
+        // A child can die before release. Suppress SIGPIPE on this owned fd
+        // only; never mutate the application's process-wide signal policy.
+        guard fcntl(fds[1], F_SETNOSIGPIPE, 1) == 0 else { return failed() }
+        return (fds[0], fds[1])
+    }
+#endif
