+    /// The caller owns every returned descriptor and the unreaped child,
+    /// including setup-error returns. A protected child cannot exec until the
+    /// caller writes one byte to gateFd; closing it instead aborts with 127.
+    static func prepareFork(andExec: String, args: [String], env: [String], currentDirectory: String? = nil,
+                            desiredWindowSize: inout winsize, preserveOutput: Bool) -> PreparedPtyLaunch? {
+        var gateRead: Int32 = -1, gateWrite: Int32 = -1
+#if os(macOS)
+        if preserveOutput {
+            guard let gate = makeLaunchGate() else { return nil }
+            gateRead = gate.0; gateWrite = gate.1
+        }
+#endif
+        var transferred = false
+        defer {
+            if gateRead >= 0 { close(gateRead) }
+            if !transferred && gateWrite >= 0 { close(gateWrite) }
+        }
