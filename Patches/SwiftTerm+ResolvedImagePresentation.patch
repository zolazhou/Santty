+    func destinationRect(cellWidth: CGFloat, cellHeight: CGFloat, imageScale: CGFloat,
+                         screenRow: Int, lineOrigin: CGPoint) -> CGRect {
+        let x = CGFloat(pixelOffsetX) / imageScale, y = CGFloat(pixelOffsetY) / imageScale
+        if let size = resolvedSize {
+            let height = CGFloat(size.height) / imageScale
+            return CGRect(x: CGFloat(geometry.column) * cellWidth + x,
+                y: lineOrigin.y + CGFloat(screenRow - geometry.row + 1) * cellHeight - y - height,
+                width: CGFloat(size.width) / imageScale, height: height)
+        }
+        let rowsBelow = geometry.row + geometry.rows - 1 - screenRow
+        return CGRect(x: CGFloat(geometry.column) * cellWidth + x,
+            y: lineOrigin.y - CGFloat(rowsBelow) * cellHeight + y,
+            width: max(0, CGFloat(geometry.columns) * cellWidth - x),
+            height: max(0, CGFloat(geometry.rows) * cellHeight - y))
+    }
