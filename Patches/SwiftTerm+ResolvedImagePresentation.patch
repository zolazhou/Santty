+// Resolved image crops clamp to source pixel centers, not to the whole
+// texture. Clipping destination quads must not change these source bounds.
+fragment float4 terminal_image_crop_fragment(GlyphOut in [[stage_in]],
+                                              texture2d<float> atlas [[texture(0)]],
+                                              sampler samp [[sampler(0)]],
+                                              constant float4 &bounds [[buffer(0)]]) {
+    float4 tex = atlas.sample(samp, clamp(in.texCoord, bounds.xy, bounds.zw));
+    return float4(tex.rgb * in.color.rgb, tex.a * in.color.a);
+}
